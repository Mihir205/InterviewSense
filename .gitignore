# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
dist/
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Environment variables ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Node.js / Next.js ─────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# ── Model weights (large binary files — download separately) ──────────────────
models/*.dat
models/*.onnx
models/*.caffemodel
models/*.prototxt

# ── Video uploads (never commit candidate videos) ─────────────────────────────
uploads/

# ── Database (generated at runtime) ───────────────────────────────────────────
db/*.db
db/*.sqlite
db/*.sqlite3

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
