# InterviewSense Backend — Environment Variables
# Copy this file to .env and fill in any values you want to override.

# SQLite database file path (SQLAlchemy URL format)
DATABASE_URL=sqlite:///./db/interviewsense.db

# Directory where uploaded videos are temporarily stored
UPLOAD_DIR=uploads

# Maximum allowed upload size in megabytes
MAX_UPLOAD_SIZE_MB=500

# Target FPS for frame sampling during analysis (10–15 recommended)
PROCESSING_FPS=12

# Comma-separated origins allowed by the CORS middleware
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
